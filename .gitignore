# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量与密钥
.env
.env.local
.env.*.local

# 运行时数据（数据库 / 日志 / 备份 / 截图 / 证书 / 实盘会话）
data/*
