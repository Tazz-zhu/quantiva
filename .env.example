# ===== Quantiva 环境变量示例（.env）=====

# 交易所 API（ccxt：okx / binance / bybit 等）
CCXT_API_KEY=
CCXT_API_SECRET=
# OKX API v5 必填：创建 API Key 时设置的口令（passphrase）
CCXT_API_PASSPHRASE=

# 可选：国内网络访问 OKX 等海外交易所需代理（HTTP_PROXY/HTTPS_PROXY 同样生效）
# HTTPS_PROXY=http://127.0.0.1:7890

# 飞书机器人 Webhook（可选）
FEISHU_WEBHOOK=

# AI API Key（DeepSeek / OpenAI 等 OpenAI 兼容接口；config.yaml 中 base_url 对应切换）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 服务端口（docker-compose 使用）
QUANTX_PORT=8686